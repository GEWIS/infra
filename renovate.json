{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "flux": {
    "managerFilePatterns": ["/^flux/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^flux/.+\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^terraform/grafana-config/dashboards\\.tf$/"],
      "matchStrings": ["raw\\.githubusercontent\\.com/(?<depName>cilium/cilium)/(?<currentValue>v[^/]+)/"],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^terraform/talos-bootstrap/gateway-api\\.tf$/"],
      "matchStrings": ["gateway_api_version = \"(?<currentValue>v[^\"]+)\""],
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "datasourceTemplate": "github-releases"
    }
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
