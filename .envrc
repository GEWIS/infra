use flake

export BAO_ADDR=https://openbao.cbc.gewis.nl:8443

if TF_VAR_state_passphrase="$(sops -d --extract '["state_passphrase"]' secrets/tofu.yaml 2>/dev/null)"; then
  export TF_VAR_state_passphrase
else
  unset TF_VAR_state_passphrase
  log_status "sops could not decrypt secrets/tofu.yaml; tofu state operations will not work"
fi

if TF_VAR_talos_secrets="$(sops -d secrets/talos.yaml 2>/dev/null)"; then
  export TF_VAR_talos_secrets
else
  unset TF_VAR_talos_secrets
  log_status "sops could not decrypt secrets/talos.yaml; talos operations will not work"
fi

if TF_VAR_sealed_secrets_key="$(sops -d secrets/sealed-secrets.yaml 2>/dev/null)"; then
  export TF_VAR_sealed_secrets_key
else
  unset TF_VAR_sealed_secrets_key
  log_status "sops could not decrypt secrets/sealed-secrets.yaml; the pinned sealing key cannot be seeded"
fi

if TF_VAR_garage_admin_token="$(sops -d --extract '["garage-admin-token"]' secrets/s3-01.yaml 2>/dev/null)"; then
  export TF_VAR_garage_admin_token
else
  unset TF_VAR_garage_admin_token
  log_status "sops could not decrypt secrets/s3-01.yaml; garage bucket operations will not work"
fi

if TF_VAR_ad_bind_password="$(sops -d --extract '["ad-bind-password"]' secrets/authentik.yaml 2>/dev/null)"; then
  export TF_VAR_ad_bind_password
else
  unset TF_VAR_ad_bind_password
  log_status "sops could not decrypt secrets/authentik.yaml; the authentik LDAP source cannot be configured"
fi

if [ -n "${TF_VAR_talos_secrets:-}" ]; then
  export TALOSCONFIG="$PWD/.talos/config"
  export KUBECONFIG="$PWD/.kube/config"
  if [ ! -f "$TALOSCONFIG" ] || [ ! -f "$KUBECONFIG" ]; then
    if mint-creds "$TALOSCONFIG" "$KUBECONFIG"; then
      log_status "generated talos/kube creds -> .talos/config .kube/config"
    else
      log_status "mint-creds failed; talos/kube creds not generated"
    fi
  fi
fi

if TF_VAR_bao_jwt="$(kubectl -n openbao create token openbao-admin 2>/dev/null)"; then
  export TF_VAR_bao_jwt
else
  unset TF_VAR_bao_jwt
fi

source_env_if_exists .envrc.local
