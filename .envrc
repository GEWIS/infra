use flake

if TF_VAR_state_passphrase="$(sops -d --extract '["state_passphrase"]' secrets/tofu.yaml 2>/dev/null)"; then
  export TF_VAR_state_passphrase
else
  unset TF_VAR_state_passphrase
  log_status "sops could not decrypt secrets/tofu.yaml; tofu state operations will not work"
fi

if TF_VAR_talos_secrets="$(sops -d secrets/talos.yaml 2>/dev/null)"; then
  export TF_VAR_talos_secrets
else
  unset TF_VAR_talos_secrets
  log_status "sops could not decrypt secrets/talos.yaml; talos operations will not work"
fi

if [ -n "${TF_VAR_talos_secrets:-}" ]; then
  export TALOSCONFIG="$PWD/.talos/config"
  export KUBECONFIG="$PWD/.kube/config"
  if [ ! -f "$TALOSCONFIG" ] || [ ! -f "$KUBECONFIG" ]; then
    if mint-creds "$TALOSCONFIG" "$KUBECONFIG"; then
      log_status "generated talos/kube creds -> .talos/config .kube/config"
    else
      log_status "mint-creds failed; talos/kube creds not generated"
    fi
  fi
fi

source_env_if_exists .envrc.local
